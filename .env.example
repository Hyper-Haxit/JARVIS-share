# JARVIS environment variables (all optional).
#
# Copy this file to `.env` if you like, then load it in your shell before running
# `jarvis` (for example with `set -a; source .env; set +a` in bash, or by setting
# the variables in your terminal / system settings). `.env` is git-ignored.
#
# Nothing here is required: JARVIS runs out of the box with a local Ollama server
# and keeps everything it stores under a single "home" folder.

# ---- Where JARVIS keeps its state (database, config.toml, logs, models, secrets)
# Default: Windows %USERPROFILE%\.jarvis   macOS ~/Library/Application Support/JARVIS
#          Linux  ~/.local/share/jarvis
# JARVIS_HOME=/path/to/jarvis-home

# ---- Any setting from config.toml can be overridden as JARVIS__SECTION__KEY
# JARVIS__SERVER__PORT=7777
# JARVIS__SERVER__HOST=127.0.0.1
# JARVIS__VOICE__ENABLED=true
# JARVIS__ROUTING__MODE=auto

# ---- Secrets (API keys, tokens)
# Prefer `jarvis secret set <name>`, which stores the value in your OS credential
# store (Windows Credential Manager / macOS Keychain / Secret Service). As an
# alternative, any secret can be given as JARVIS_SECRET_<NAME> (upper-case).
# The names below are the ones the default config refers to.
# JARVIS_SECRET_ANTHROPIC_API_KEY=
# JARVIS_SECRET_OPENAI_API_KEY=
# JARVIS_SECRET_BRAVE_API_KEY=
# JARVIS_SECRET_HOME_ASSISTANT_TOKEN=

# Keep secrets in the protected file inside JARVIS_HOME instead of the OS store
# (headless machines, containers, CI). Not encrypted at rest.
# JARVIS_SECRETS_BACKEND=file

# ---- Tests
# JARVIS_TEST_OLLAMA=http://127.0.0.1:11434
